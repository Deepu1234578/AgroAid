<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══ HERO HEADER ══ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#1B5E20"
            android:padding="24dp">

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-60dp"
                android:background="@drawable/circle_overlay"
                android:alpha="0.15"/>

            <!-- Top row: Logo + Logout top-right -->
            <LinearLayout
                android:id="@+id/topRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿"
                    android:textSize="26sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="AgroAid"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"/>

                <!-- Logout button: top-right, amber/gold tint -->
                <ImageView
                    android:id="@+id/btnLogout"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_lock_power_off"
                    android:background="#33FFD54F"
                    android:padding="9dp"
                    app:tint="#FFD54F"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"/>
            </LinearLayout>

            <!-- Greeting text -->
            <LinearLayout
                android:id="@+id/greetingLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/topRow"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello, Farmer 👋"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Let's protect your crops and grow better together."
                    android:textColor="#A5D6A7"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Compact weather strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/greetingLayout"
                android:layout_marginTop="14dp"
                android:background="#33FFFFFF"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/txtTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="--°C"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Loading..."
                    android:textColor="#C8E6C9"
                    android:textSize="12sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txtLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Detecting..."
                    android:textColor="#81C784"
                    android:textSize="11sp"/>
            </LinearLayout>

        </RelativeLayout>

        <!-- ══ WHITE ROUNDED PANEL ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F2F6F2"
            android:layout_marginTop="-20dp"
            android:paddingTop="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ── TOP 5 HIGH DEMAND – replaces removed Dashboard + Weather cards ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔥 Top 5 High Demand"
                    android:textColor="#1A2E1A"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSeeAllDemand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See Market →"
                    android:textColor="#2E7D32"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Horizontal scroll of demand chips -->


            <!-- Horizontal scroll of demand chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:id="@+id/demandChipsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Chip 1: Cumin (Jeera) — Rajasthan -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="140dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🌿" android:textSize="18sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp" android:text="Cumin" android:textColor="#1A2E1A"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="↑ 30% demand"
                                android:textColor="#E65100" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="1dp" android:text="₹27,000/qtl"
                                android:textColor="#555" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp" android:text="📍 Rajasthan"
                                android:textColor="#2E7D32" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Chip 2: Chilli — Andhra Pradesh -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="140dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🌶" android:textSize="18sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp" android:text="Chilli" android:textColor="#1A2E1A"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="↑ 25% demand"
                                android:textColor="#E65100" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="1dp" android:text="₹13,500/qtl"
                                android:textColor="#555" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp" android:text="📍 Andhra Pradesh"
                                android:textColor="#2E7D32" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Chip 3: Onion — Maharashtra -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="140dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🧅" android:textSize="18sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp" android:text="Onion" android:textColor="#1A2E1A"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="↑ 22% demand"
                                android:textColor="#E65100" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="1dp" android:text="₹35/kg"
                                android:textColor="#555" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp" android:text="📍 Maharashtra"
                                android:textColor="#2E7D32" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Chip 4: Arecanut — Karnataka -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="140dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🌴" android:textSize="18sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp" android:text="Arecanut" android:textColor="#1A2E1A"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="↑ 22% demand"
                                android:textColor="#2E7D32" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="1dp" android:text="₹37,500/qtl"
                                android:textColor="#555" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp" android:text="📍 Karnataka"
                                android:textColor="#2E7D32" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Chip 5: Wheat — Punjab -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="140dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🌾" android:textSize="18sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp" android:text="Wheat" android:textColor="#1A2E1A"
                                    android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="↑ 15% demand"
                                android:textColor="#2E7D32" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="1dp" android:text="₹2,015/qtl"
                                android:textColor="#555" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp" android:text="📍 Punjab"
                                android:textColor="#2E7D32" android:textSize="10sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── 2-card Feature Row (Scan Plant + Market) ── -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="1"
                android:useDefaultMargins="true"
                android:layout_marginBottom="18dp">

                <!-- SCAN PLANT -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnAnalysis"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_green_light">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="📷"
                                android:textSize="22sp"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Scan Plant"
                            android:textColor="#1A2E1A"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Detect diseases instantly"
                            android:textColor="#6B8E6B"
                            android:textSize="11sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="→"
                            android:textColor="#2E7D32"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- MARKET (was Services) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnServices"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_orange_light">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="📈"
                                android:textSize="22sp"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Market"
                            android:textColor="#1A2E1A"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="State-wise prices &amp; trends"
                            android:textColor="#6B8E6B"
                            android:textSize="11sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="→"
                            android:textColor="#E65100"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <!-- ── Recent Scans (loaded from Firebase in code) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Scans"
                    android:textColor="#1A2E1A"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvViewAllScans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Recent Scans are loaded dynamically via RecyclerView or added programmatically -->
            <!-- Add a RecyclerView for dynamic scan list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- Empty state (shown when no scans exist, hidden when scans load) -->
            <LinearLayout
                android:id="@+id/emptyScansView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="36sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No scans yet. Tap 'Scan Plant' to start!"
                    android:textColor="#9E9E9E"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ══ BOTTOM NAVIGATION ══ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="75dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="4">

                <!-- HOME -->
                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="8dp">
                    <TextView android:text="🏠" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Home" android:textColor="#2E7D32" android:textStyle="bold" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                    <View android:layout_width="4dp" android:layout_height="4dp" android:background="#2E7D32" android:layout_marginTop="3dp"/>
                </LinearLayout>

                <!-- SCAN (floating centre) -->
                <LinearLayout
                    android:id="@+id/navFields"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="-16dp"
                        android:background="@drawable/circle_green_filled"
                        android:elevation="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="📷" android:textSize="22sp"/>
                    </FrameLayout>
                    <TextView android:text="Scan" android:textColor="#2E7D32" android:textStyle="bold" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- MARKET (was History) -->
                <LinearLayout
                    android:id="@+id/navMarket"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="8dp">
                    <TextView android:text="📈" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Market" android:textColor="#9E9E9E" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- PROFILE -->
                <LinearLayout
                    android:id="@+id/navProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="8dp">
                    <TextView android:text="👤" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Profile" android:textColor="#9E9E9E" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>