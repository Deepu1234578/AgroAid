<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Green hero header ── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#1B5E20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginTop="-20dp"
                android:text="🌿"
                android:textSize="40sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="30dp"
                android:text="Complete Your Profile"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="18dp"
                android:text="Tell us about you and your farm"
                android:textColor="#A5D6A7"
                android:textSize="13sp"/>
        </RelativeLayout>

        <!-- ── Avatar picker ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="-36dp"
            android:layout_marginBottom="4dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circle_green_filled"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"/>

                <!-- Edit overlay -->
                <FrameLayout
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:background="#2E7D32">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✏"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"/>
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvPickPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Upload Photo (optional)"
                android:textColor="#2E7D32"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- ── Form card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Section: Personal Info -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤  Personal Information"
                    android:textColor="#1B5E20"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <!-- First Name -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="First Name *" android:textColor="#4A4A4A" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/firstName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="Enter first name"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp"/>

                <!-- Last Name -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Last Name" android:textColor="#4A4A4A" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/lastName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="Enter last name"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp"/>

                <!-- Phone -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Phone Number *" android:textColor="#4A4A4A" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="+91 00000 00000"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="phone"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp"/>

                <!-- Email -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Email Address *" android:textColor="#4A4A4A" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="farmer@example.com"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"/>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#E0E0E0" android:layout_marginBottom="18dp"/>

                <!-- Section: Farm Info -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌾  Farm Information"
                    android:textColor="#1B5E20"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp"/>

                <!-- State -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="State *" android:textColor="#4A4A4A" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerState"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="14dp"/>

                <!-- Farm Size -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Farm Size (Acres)" android:textColor="#4A4A4A" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/farmSize"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="e.g. 5"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="numberDecimal"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp"/>

                <!-- Primary Crop -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Primary Crop" android:textColor="#4A4A4A" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerCrop"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="14dp"/>

                <!-- Farming Type -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Farming Type" android:textColor="#4A4A4A" android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <RadioGroup
                        android:id="@+id/rgFarmingType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbOrganic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌱 Organic"
                            android:textSize="13sp"
                            android:textColor="#2E7D32"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/rbConventional"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🏭 Conventional"
                            android:textSize="13sp"
                            android:textColor="#555"/>

                        <RadioButton
                            android:id="@+id/rbMixed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚗ Mixed"
                            android:textSize="13sp"
                            android:textColor="#555"/>
                    </RadioGroup>
                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#E0E0E0" android:layout_marginBottom="18dp"/>

                <!-- Section: Preferred Language -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗣  Preferred Language"
                    android:textColor="#1B5E20"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="24dp"/>

                <!-- SAVE Button -->
                <Button
                    android:id="@+id/saveBtn"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Save &amp; Continue →"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_green_rounded"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* Required fields"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"
                    android:gravity="center"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>